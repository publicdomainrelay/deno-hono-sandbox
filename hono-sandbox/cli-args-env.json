{
  "name": "hono-sandbox",
  "description": "Deno worker sandbox server",
  "options": {
    "port": {
      "type": "number",
      "env": "PORT",
      "default": 2584,
      "description": "HTTP listen port"
    },
    "hostname": {
      "type": "string",
      "env": "HOSTNAME",
      "default": "127.0.0.1",
      "description": "HTTP listen hostname"
    },
    "timeout-ms": {
      "type": "number",
      "env": "SANDBOX_TIMEOUT_MS",
      "description": "Default execution timeout in milliseconds"
    },
    "tls-cert-file": {
      "type": "string",
      "description": "PEM certificate to serve TLS with; requires tls-key-file",
      "env": "TLS_CERT_FILE"
    },
    "tls-key-file": {
      "type": "string",
      "description": "PEM private key to serve TLS with; requires tls-cert-file",
      "env": "TLS_KEY_FILE"
    },
    "port-file": {
      "type": "string",
      "description": "File the bound TCP port is written to once listening (used with port 0)",
      "env": "PORT_FILE",
      "default": "./port-bound-to"
    }
  }
}
